global:
  edition: ce
  hosts:
    domain: DOMAIN_NAME
    https: false
  ingress:
    enabled: false
  
gitlab:
  webservice:
    enabled: true
    replicaCount: 1
    ingress:
      enabled: false
    service:
      type: ClusterIP
      port: 8080
  
  sidekiq:
    enabled: true
    replicaCount: 1
  
  gitaly:
    enabled: true
    persistence:
      enabled: true
      size: 10Gi
      storageClass: gp3
  
  gitlab-shell:
    enabled: true
    service:
      type: ClusterIP

postgresql:
  install: true
  persistence:
    enabled: true
    size: 8Gi
    storageClass: gp3

redis:
  install: true
  persistence:
    enabled: true
    size: 5Gi
    storageClass: gp3

nginx-ingress:
  enabled: false

certmanager:
  install: false

prometheus:
  install: false

gitlab-runner:
  install: false